# Copy to .env on the server (never commit the real file).
# Shared secret for the server-to-server endpoint used by the Vera landing page
# widget (POST /api/external/vera-qa, header X-Vera-QA-Secret).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
VERA_QA_SHARED_SECRET=replace-me
